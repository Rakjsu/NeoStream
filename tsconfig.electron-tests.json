{
  // Testes do processo principal (electron/**/*.test.ts) + specs E2E (e2e/).
  // Ficam fora do tsconfig.electron.json porque precisam da lib DOM: os
  // testes do main rodam em jsdom e os specs escrevem callbacks de
  // page.evaluate() que executam no renderer (D144).
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.electron-tests.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    // Testes do main importam componentes .tsx de src/.
    "jsx": "react-jsx",

    /* Linting */
    // Sem `erasableSyntaxOnly`: testes do main também usam parameter
    // properties, que o esbuild do Vitest transpila.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // As duas declarações globais do renderer (window.ipcRenderer,
  // __APP_VERSION__, import.meta.env) entram porque testes do main e specs
  // E2E importam módulos de src/ ou falam com window.ipcRenderer.
  "include": ["electron/**/*.test.ts", "e2e", "src/vite-env.d.ts", "src/types/electron.d.ts"]
}
